        <mxCell id="7QlRNy11sMe4qah2yADF-39" parent="clEPGdFe9xM6kFZr75yi-1" style="whiteSpace=wrap;html=1;rounded=0;" value="//Function Prototype&lt;br&gt;void initialization(string* filesNames, City* cities, Board* board, int* chanceCards, int* communityChestCards);&lt;br&gt;City readCityFromFile(fstream &amp;amp;inFile, int id);&lt;br&gt;Board readBoardFromFile(fstream &amp;amp;inFile, int id);&lt;br&gt;void deallocateMemory(Player* players, City* cities, Board* board, int* chanceCards, int* communityChestCards);&lt;br&gt;void deallocateMemory(int* array);&lt;br&gt;void deallocateMemory(string* array);&lt;br&gt;int&amp;nbsp; initializePlayers(Player* players, int nOfPlyrs);&lt;br&gt;void getOrderOfPlay(Player* players, int nOfPlyrs);&lt;br&gt;void sortParallelArray(int *arr, Player* players, int size);&lt;br&gt;int binarySearch(int * array, int value);&lt;br&gt;void sortArray(int *array, int size);&lt;br&gt;void randomizeArray(int *array, int size);&amp;nbsp;&lt;br&gt;void rollDice(int* diceRoll)&lt;br&gt;void mainGameLoop(Player* players, Board* board, City* cities, int* chanceCards, int* communityChestCards, int* housesAvailable, int* hotelsAvailable, int nOfPlyrs);&lt;br&gt;int showMenu(int menuTemplateIndex);&lt;br&gt;void handleMenuChoice(int choice,int menuTemplateIndex, int playerIndex, Player* players, Board* board, City* cities, int* chanceCards, int* communityChestCards, int* housesAvailable, int* hotelsAvailable, int nOfPlyrs);&lt;br&gt;void movePlayer(int* doublecount, bool* doubleRoll, int playerIndex, Player* players, Board* board, City* cities, int* chanceCards, int* communityChestCards, int* housesAvailable, int* hotelsAvailable, int nOfPlyrs);&lt;br&gt;void locationAction(int playerIndex, int rollTotal, Player* players, Board* board, City* cities, int* chanceCards, int* communityChestCards);&lt;br&gt;void payRentOrTax(int playerIndex, int rollTotal, Player* player, Board* board, City* cities);&lt;br&gt;void buyProperty(int playerIndex, Player* players, Board* board, City* cities);&lt;br&gt;void drawChanceCard(int playerIndex, Player* players, int* chanceCards, Board* board, City* cities);&lt;br&gt;void drawCommunityChestCard(int playerIndex, Player* players, int* communityChestCards, Board* board, City* cities);&lt;br&gt;void goToJail(int playerIndex, Player* players);&lt;br&gt;void jailTurn(int playerIndex, Player* players, Board* board, City* cities);&lt;br&gt;void moneyTransaction(int fromPlayerIndex, int toPlayerIndex, Player* players, int amount);&lt;br&gt;void moneyTransaction(int playerIndex, Player* players, int amount);&lt;br&gt;void handleLowBalance(int playerIndex, int amount, Player* players, Board* board, City* cities);&lt;br&gt;void upgradeProperty(int playerIndex, int* housesAvailable, int* hotelsAvailable, Player* players, Board* board, City* cities);&lt;br&gt;void mortgageProperty(int playerIndex, Player* players, Board* board, City* cities);&lt;br&gt;void unmortgageProperty(int playerIndex, Player* players, Board* board, City* cities);&lt;br&gt;void sellProperty(int playerIndex, Player* players, Board* board, City* cities);&lt;br&gt;void tradeProperty(int playerIndex, Player* players, Board* board, City* cities);&lt;br&gt;int declareBankruptcy(int playerIndex, int* housesAvailable, int* hotelsAvailable, Player* players, Board* board, City* cities);&lt;br&gt;void calculateGroupOwned(int propertyID, int playerIndex, Player* players, City* cities);&lt;br&gt;void listPlayerProperties(int playerIndex, Player* players, City* cities);&lt;br&gt;void displayPropertyOneLiner(int propertyID, City* cities);" vertex="1">
